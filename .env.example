# LLM – OpenAI
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1

# Base de données SQLite
DB_PATH=incidents.db

# Chemins données
DATA_PATH=data/
DOCS_PATH=docs/

# Vector store Chroma
CHROMA_PATH=chroma_db/
CHROMA_COLLECTION_NAME=incident_docs
EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2

# RAG
RAG_TOP_K=4
RAG_INGEST_BATCH_SIZE=50
RAG_QUERY_DESCRIPTION_MAX_CHARS=300

# API REST
API_HOST=0.0.0.0
API_PORT=8080
API_KEY=your-secret-api-key-here

# Agent – détection
DUPLICATE_WINDOW_HOURS=2
MAJOR_INCIDENT_THRESHOLD=3
CONFIDENCE_LOW_THRESHOLD=0.5
DUPLICATE_CONFIDENCE_SCORE=0.95

# Agent – fallbacks (qualification LLM échouée ou doublon)
FALLBACK_PRIORITY=P3
FALLBACK_CATEGORY=Application
FALLBACK_SUBCATEGORY=Traitement
FALLBACK_ASSIGNED_TO=team-ops

# Limites de recherche DB (performance / tuning)
DETECT_DUPLICATE_SEARCH_LIMIT=10
DETECT_MAJOR_INCIDENT_MAIN_LIMIT=5
DETECT_MAJOR_INCIDENT_DEPS_MAX=10
DETECT_MAJOR_INCIDENT_DEP_LIMIT=3
SEARCH_INCIDENTS_LIMIT=5

# Limites de contexte LLM (prompt sizing)
LLM_CONTEXT_ALERTS_LIMIT=5
LLM_CONTEXT_RAG_DOCS_LIMIT=4
LLM_RAG_DOC_TRUNCATE_CHARS=600
LLM_CONTEXT_SIMILAR_INCIDENTS_LIMIT=5

# Logs
LOG_LEVEL=INFO
